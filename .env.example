# Copy to .env for local dev, or set these in docker-compose's environment.

# AES key used to encrypt backend-managed wallet secret keys at rest. Generate with:
#   openssl rand -hex 32
KS_WALLET_ENCRYPTION_KEY=

# Solana Devnet RPC endpoint. Leave blank to use the public https://api.devnet.solana.com,
# which is free but rate-limited — set a dedicated Devnet RPC URL (e.g. Helius, QuickNode)
# if the public one gets flaky during a live demo.
KS_SOLANA_RPC=

# SQLite path (default: ./data/app.db; the Docker image uses /app/data/app.db)
KS_DB_PATH=

# OTP email — reuses the same Office 365 sender already working for kfleet.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=zikriya.tariq@kairossolutions.co
SMTP_PASS=
SMTP_FROM=info@kairossolutions.co
